# Copier ce fichier en `.env` et renseigner les vraies valeurs (ne jamais committer `.env`).

# PostgreSQL — Supabase ou Neon (cf. AGENTS.md § Stack technique)
# Sans cette variable, `next dev` affiche le seed (source « Saisie manuelle ») au lieu d'une 500.
# Cours live : docker compose up -d && npx prisma migrate dev && npx prisma db seed
DATABASE_URL="postgresql://user:password@host:5432/brvm_app?schema=public"

# NextAuth.js (étape 7)
# Production Vercel : valeur seule = URL absolue https (jamais le nom de la clé).
# Correct : https://brwm-app.vercel.app  (ou le domaine custom s'il est branché)
# Incorrect : NEXTAUTH_URL=https://…  → Chrome résout le host « nextauth_url=https »
# Incorrect : https  (schéma seul)
# NEXTAUTH_SECRET : `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changeme"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Emails transactionnels (confirmation d'inscription + mot de passe oublié)
# OBLIGATOIRE en production : un fournisseur ET un EMAIL_FROM valide
# (domaine réellement vérifié — pas noreply@localhost).
# Sans ça, l'UI affiche une erreur française (plus de succès silencieux).
#
# Option A — Resend (recommandé sur Vercel)
# 1. Créer une clé https://resend.com/api-keys
# 2. Vérifier le domaine https://resend.com/domains
# 3. Vercel → Settings → Environment Variables (Production + Preview) :
RESEND_API_KEY=""
EMAIL_FROM="OuestBourse <noreply@votre-domaine-verifie.com>"
#
# Option B — SMTP (Nodemailer), à la place de RESEND_API_KEY
# EMAIL_SERVER="smtp://user:pass@smtp.exemple.com:587"
# EMAIL_FROM="OuestBourse <noreply@votre-domaine-verifie.com>"
# Alternative SMTP éclatée :
# EMAIL_SERVER_HOST="smtp.exemple.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""
# EMAIL_SERVER_SECURE="false"

# Cache marché (étape 4/6) — Redis ou Vercel KV
REDIS_URL=""

# Ingestion multi-source (étape 3/6)
INGESTION_USER_AGENT="BRVMAppBot/1.0 (+https://brvm-app.vercel.app; contact: admin@brvm-app.example)"

# Secret partagé avec Vercel Cron pour protéger GET /api/cron/ingest,
# GET /api/cron/refresh-quotes, GET /api/cron/research,
# GET /api/cron/history-backfill, GET /api/cron/refresh-documents
# et GET /api/cron/refresh-chart-series
# (Vercel l'injecte automatiquement comme en-tête `Authorization: Bearer ...`
# sur les requêtes cron programmées).
# Générer une valeur aléatoire forte, ex: `openssl rand -hex 32`.
CRON_SECRET="changeme"

# Scheduler local horaire (npm run quotes:hourly) — URL du next dev / next start.
# QUOTES_SCHEDULER_BASE_URL="http://localhost:3100"

# Performance graphes — densification live Sika/Rich/OuestBourse
# CHART_DENSIFY_TIMEOUT_MS="4500"   # au-delà → série DB immédiate (+ cache en fond)
# CHARTS_SKIP_LIVE_DENSIFY="true"   # local ultra-rapide : jamais d'appel live (série DB seule)

# Webhook optionnel (Slack/Discord/Teams — payload générique `{ text }`) pour
# recevoir les alertes d'ingestion (source en échec, écarts de cours > 2%,
# ticker inconnu). Laisser vide pour se limiter aux logs console/Vercel.
INGESTION_ALERT_WEBHOOK_URL=""

# Feature flags par connecteur/opération (cf. lib/ingestion/connector-config.ts)
# — décommenter et passer à "false" pour désactiver une source en urgence
# sans redéployer de code (ex: blocage anti-scraping soudain).
# INGESTION_ENABLE_BRVM_INDICES="true"
# INGESTION_ENABLE_BRVM_QUOTES="true"
# INGESTION_ENABLE_SIKAFINANCE_INDICES="true"
# INGESTION_ENABLE_SIKAFINANCE_QUOTES="true"  # A–Z #tblShare (activé par défaut depuis 10/09/2026)
# Historique annuel / journalier : npm run history:sikafinance / enrich:sikafinance (GetHistos)
# Backfill max (annuel→mensuel→journalier + fiches + events) : npm run history:sika-full
# INGESTION_ENABLE_HISTORY_BACKFILL="true"
# INGESTION_ENABLE_SIKA_DAILY_HISTORY="true"
# Journalier GetHistos : 1 an glissant d'abord (évite forceDaily 2006→aujourd'hui).
# INGESTION_DAILY_FROM="1Y"          # défaut — couverture récente
# INGESTION_DAILY_FROM="auto"        # historique profond (première date Sika)
# INGESTION_DAILY_FROM="2015-01-01"  # date ISO explicite
# Tickers Sika nodata à sauter (en plus du flag DB skip_history_backfill) :
# HISTORY_SKIP_TICKERS="NEIC,PRSC,SEMC"
# HISTORY_ALLOW_TICKERS="NEIC"       # force un ticker malgré le flag DB
# Collier séance BRVM (~±7,5 %) à l'upsert canonique :
# PRICE_COLLAR_DISABLED="false"
# BRVM_PRICE_COLLAR_PERCENT="7.5"
# PRICE_COLLAR_OVERRIDE_TICKERS=""
# Refresh séries graphes : npm run charts:refresh
# Cron manuel : GET /api/cron/refresh-chart-series?budgetMs=45000
# INGESTION_ENABLE_SIKA_SHEETS="true"
# INGESTION_ENABLE_SIKA_EVENTS="true"
# INGESTION_ENABLE_OB_DOCUMENTS="true"
# Refresh documents/résultats (catalogue BRVM via OB) après le cron ingest
# INGESTION_DOCUMENTS_ON_CRON="true"
# CLI : npm run docs:refresh   ·   cron manuel : GET /api/cron/refresh-documents
# Enchaîner un rattrapage borné après le cron ingest (défaut false, Hobby 300 s)
# INGESTION_HISTORY_BACKFILL_ON_CRON="false"
# Historique / composition des indices (GetHistos BRVMC/BRVM30 + avis BRVM 30)
# INGESTION_ENABLE_INDEX_HISTORY="true"
# INGESTION_ENABLE_INDEX_COMPOSITION="true"
# INGESTION_INDEX_COMPOSITION_ON_CRON="true"
# INGESTION_INDEX_RECENT_HISTORY_ON_CRON="true"
# Backfill complet : npm run history:indices
# Cron manuel : GET /api/cron/index-enrichment?budgetMs=240000
# INGESTION_ENABLE_RICHBOURSE_INDICES="true"
# INGESTION_ENABLE_RICHBOURSE_QUOTES="true"

# Agent de recherche IA (étape 10) — veille UX/produit/concurrence/DESIGN.
# RESEARCH_AGENT_ENABLED="true" active les appels réseau + propositions
# journalières (cron 06:00 UTC et `npm run research:run`) :
#   - avec RESEARCH_SEARCH_API_KEY → SerpAPI (recommandé en prod)
#   - sans clé → fallback Google News RSS (best-effort)
RESEARCH_AGENT_ENABLED="true"
RESEARCH_SEARCH_API_KEY=""

# Historique ouestbourse.com (Supabase REST public — clé publishable du front)
# OUESTBOURSE_SUPABASE_URL="https://xxxx.supabase.co"
# OUESTBOURSE_SUPABASE_ANON_KEY="sb_publishable_..."

# Analytique première partie (clics / pages) — vue /admin/analytics
# Désactiver en local : passer les deux à false (le client n'envoie rien,
# le serveur ignore les POST).
ANALYTICS_TRACKING_ENABLED="true"
NEXT_PUBLIC_ANALYTICS_TRACKING_ENABLED="true"
# Conservation des événements (jours). Purge à l'ouverture du dashboard admin.
ANALYTICS_RETENTION_DAYS="90"
# Accès admin : User.role = ADMIN en base, OU emails listés ici (virgules).
# ADMIN_EMAILS="owner@example.com"
